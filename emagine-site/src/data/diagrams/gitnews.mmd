graph TD
    subgraph App["GitNews CLI (.NET 8)"]
        CLI["CLI Entry Point"]
        RepoFetcher["Repo Fetcher"]
        ArticleGen["Article Generator"]
    end
    subgraph External["External Services"]
        Octokit["Octokit (GitHub API)"]
        GPT["OpenAI GPT-4"]
    end
    subgraph Data["Data Layer"]
        Embeddings["pgvector Embeddings"]
    end
    DB[("PostgreSQL + pgvector")]

    CLI -->|"Fetch Repos"| RepoFetcher
    RepoFetcher -->|"API"| Octokit
    Octokit -->|"Repo Data"| ArticleGen
    ArticleGen -->|"Generate"| GPT
    ArticleGen -->|"Embed"| Embeddings
    Embeddings -->|"Store"| DB
    ArticleGen -->|"Store"| DB

