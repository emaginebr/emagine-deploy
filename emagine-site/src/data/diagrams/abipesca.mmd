graph TD
    subgraph App["Abipesca (React 19)"]
        AbipescaApp["Abipesca App"]
        NAuthReact["nauth-react (NPM Package)"]
        NNewsReact["nnews-react (NPM Package)"]
        BazzucaReact["bazzuca-react (NPM Package)"]
    end
    subgraph External["External APIs"]
        NAuthAPI["NAuth API"]
        NNewsAPI["NNews API"]
        BazzucaAPI["BazzucaMedia API"]
    end

    AbipescaApp --> NAuthReact
    AbipescaApp --> NNewsReact
    AbipescaApp --> BazzucaReact
    NAuthReact -->|"Auth"| NAuthAPI
    NNewsReact -->|"CMS"| NNewsAPI
    BazzucaReact -->|"Push Notification"| BazzucaAPI

    click NAuthAPI mermaidCallback "NAuth"
    click NNewsAPI mermaidCallback "NNews"
    click BazzucaAPI mermaidCallback "BazzucaMedia"

    style AbipescaApp fill:#2980b9,stroke:#1a5276,color:#fff
    style NAuthReact fill:#c0392b,stroke:#96281B,color:#fff
    style NNewsReact fill:#c0392b,stroke:#96281B,color:#fff
    style BazzucaReact fill:#c0392b,stroke:#96281B,color:#fff
    style NAuthAPI fill:#28a745,stroke:#1e7e34,color:#fff
    style NNewsAPI fill:#28a745,stroke:#1e7e34,color:#fff
    style BazzucaAPI fill:#28a745,stroke:#1e7e34,color:#fff

    style App fill:#e8f4fd,stroke:#61DAFB,color:#000
    style External fill:#d4edda,stroke:#28a745,color:#000

