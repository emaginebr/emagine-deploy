graph TD
    subgraph App["KryptoDrive (.NET MAUI)"]
        FileManager["File Manager"]
    end
    subgraph Encryption["Encryption Layer"]
        PBKDF2["PBKDF2 Key Derivation"]
        AES["AES-256 Encryption"]
    end
    subgraph Cloud
        GDrive["Google Drive"]
    end

    FileManager -->|"Passphrase"| PBKDF2
    PBKDF2 -->|"Key"| AES
    FileManager -->|"Encrypt/Decrypt"| AES
    AES -->|"Sync"| GDrive

    click FileManager mermaidCallback "FileManager"
    click PBKDF2 mermaidCallback "PBKDF2"
    click AES mermaidCallback "AES"
    click GDrive mermaidCallback "GDrive"

