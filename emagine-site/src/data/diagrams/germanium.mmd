graph TD
    subgraph App["Germanium CLI (.NET 9)"]
        CLI["CLI Entry Point"]
        FileReader["File Reader"]
    end
    subgraph Processing["Processing Pipeline"]
        Parser["Source Code Parser"]
        Tokenizer["Syntax Tokenizer"]
        ThemeEngine["Theme Engine"]
    end
    subgraph Rendering["Rendering"]
        Renderer["SkiaSharp Renderer"]
        PNG["PNG Output"]
    end

    CLI -->|"Input"| FileReader
    FileReader -->|"Source"| Parser
    Parser -->|"Tokens"| Tokenizer
    Tokenizer -->|"Styled Tokens"| Renderer
    ThemeEngine -->|"Styles"| Renderer
    Renderer -->|"Render"| PNG

    style CLI fill:#512BD4,stroke:#3a1d9e,color:#fff
    style FileReader fill:#512BD4,stroke:#3a1d9e,color:#fff
    style Parser fill:#512BD4,stroke:#3a1d9e,color:#fff
    style Tokenizer fill:#512BD4,stroke:#3a1d9e,color:#fff
    style ThemeEngine fill:#f7b731,stroke:#d4991a,color:#000
    style Renderer fill:#e91e63,stroke:#c2185b,color:#fff
    style PNG fill:#28a745,stroke:#1e7e34,color:#fff

    style App fill:#ede7f6,stroke:#512BD4,color:#000
    style Processing fill:#fff8e1,stroke:#f7b731,color:#000
    style Rendering fill:#d4edda,stroke:#28a745,color:#000

    linkStyle default stroke:#999,stroke-width:2px
