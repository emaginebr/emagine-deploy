graph TD
    subgraph App
        CLI["Germanium CLI (.NET 9)"]
    end
    subgraph Processing
        Parser["Source Code Parser"]
        ThemeEngine["Theme Engine"]
        Renderer["SkiaSharp Renderer"]
    end
    subgraph Output
        PNG["PNG Output"]
    end

    CLI -->|"Input"| Parser
    Parser -->|"Tokens"| Renderer
    ThemeEngine -->|"Styles"| Renderer
    Renderer -->|"Render"| PNG

    click CLI mermaidCallback "CLI"
    click Parser mermaidCallback "Parser"
    click ThemeEngine mermaidCallback "ThemeEngine"
    click Renderer mermaidCallback "Renderer"
    click PNG mermaidCallback "PNG"

