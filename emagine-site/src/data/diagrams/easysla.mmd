graph TD
    subgraph Frontend
        EasySLAApp["EasySLA App (React)"]
        EasySLAReact["easysla-react (NPM Package)"]
    end
    subgraph API["API"]
        APIServer["EasySLA API (.NET 8)"]
        BoardCtrl["Board Controller"]
        CardCtrl["Card Controller"]
        SLAEngine["SLA Engine"]
        ClientPortal["Client Portal"]
    end
    subgraph External["External Services"]
        NAuth["NAuth"]
        zTools["zTools"]
    end
    DB[("PostgreSQL")]

    EasySLAApp --> EasySLAReact
    EasySLAReact -->|"REST"| APIServer
    APIServer --> BoardCtrl
    APIServer --> CardCtrl
    APIServer --> SLAEngine
    APIServer --> ClientPortal
