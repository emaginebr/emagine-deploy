graph TD
    subgraph Frontend
        FrontendApp["Frontend React"]
    end
    subgraph API["API Layer"]
        APIServer["Pandora Vault API (.NET Core)"]
        VaultCtrl["Vault Controller"]
        FileCtrl["File Controller"]
    end
    subgraph Security["Security Layer"]
        AES["AES-256 Encryption"]
        ZeroKnowledge["Zero-Knowledge Layer"]
    end
    DB[(" PostgreSQL")]

    FrontendApp -->|"REST"| APIServer
    APIServer --> VaultCtrl
    APIServer --> FileCtrl
    VaultCtrl -->|"Encrypt"| AES
    FileCtrl -->|"Encrypt"| AES
    AES -->|"Zero-Knowledge"| ZeroKnowledge
    VaultCtrl -->|"Store"| DB
    FileCtrl -->|"Store"| DB

    click FrontendApp mermaidCallback "Frontend"
    click APIServer mermaidCallback "API"
    click VaultCtrl mermaidCallback "VaultCtrl"
    click FileCtrl mermaidCallback "FileCtrl"
    click AES mermaidCallback "AES"
    click ZeroKnowledge mermaidCallback "ZeroKnowledge"
    click DB mermaidCallback "DB"

    style FrontendApp fill:#61DAFB,stroke:#21a1c9,color:#000
    style APIServer fill:#512BD4,stroke:#3a1d9e,color:#fff
    style VaultCtrl fill:#512BD4,stroke:#3a1d9e,color:#fff
    style FileCtrl fill:#512BD4,stroke:#3a1d9e,color:#fff
    style AES fill:#f7b731,stroke:#d4991a,color:#000
    style ZeroKnowledge fill:#f7b731,stroke:#d4991a,color:#000
    style DB fill:#336791,stroke:#264d6e,color:#fff

    style Frontend fill:#e8f4fd,stroke:#61DAFB,color:#000
    style API fill:#ede7f6,stroke:#512BD4,color:#000
