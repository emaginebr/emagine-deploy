graph TD
    subgraph Frontend
        PVApp["Pandora Vault App (React)"]
    end
    subgraph API["API"]
        APIServer["PandoraVault API (.NET Core)"]
        VaultCtrl["Vault Controller"]
        FileCtrl["File Controller"]
    end
    subgraph Security["Security Layer"]
        EncryptionSvc["AES-256 Encryption"]
        ZeroKnowledge["Zero-Knowledge Layer"]
    end
    subgraph External["External Services"]
        NAuth["NAuth"]
    end
    DB[("PostgreSQL")]

    PVApp -->|"REST"| APIServer
    APIServer --> VaultCtrl
    APIServer --> FileCtrl
    VaultCtrl -->|"Encrypt"| EncryptionSvc
    FileCtrl -->|"Encrypt"| EncryptionSvc
    EncryptionSvc -->|"Zero-Knowledge"| ZeroKnowledge
    VaultCtrl -->|"CRUD"| DB
    FileCtrl -->|"CRUD"| DB
    APIServer -->|"Auth"| NAuth

    click NAuth mermaidCallback "NAuth"

    style PVApp fill:#2980b9,stroke:#1a5276,color:#fff
    style APIServer fill:#512BD4,stroke:#3a1d9e,color:#fff
    style VaultCtrl fill:#512BD4,stroke:#3a1d9e,color:#fff
    style FileCtrl fill:#512BD4,stroke:#3a1d9e,color:#fff
    style EncryptionSvc fill:#f7b731,stroke:#d4991a,color:#000
    style ZeroKnowledge fill:#f7b731,stroke:#d4991a,color:#000
    style NAuth fill:#28a745,stroke:#1e7e34,color:#fff
    style DB fill:#336791,stroke:#264d6e,color:#fff

    style Frontend fill:#e8f4fd,stroke:#61DAFB,color:#000
    style API fill:#ede7f6,stroke:#512BD4,color:#000
    style Security fill:#fff8e1,stroke:#f7b731,color:#000
    style External fill:#f8d7da,stroke:#dc3545,color:#000

    linkStyle default stroke:#999,stroke-width:2px
