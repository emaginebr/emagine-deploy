graph TB
    subgraph Internet["Internet (HTTPS)"]
        U((Usuários))
    end

    subgraph Cloudflare["Cloudflare"]
        EDGE[Edge: TLS, Always Use HTTPS,<br/>Redirect Rules do www]
        ACCESS[Cloudflare Access<br/>rancher.emagine.com.br]
        TUNNEL[Tunnel emagine-k8s]
    end

    subgraph Server["Servidor Docker (emagine-network)"]
        subgraph Nginx["emagine-app1 (Nginx Alpine)"]
            direction TB
            SSL[SSL/TLS<br/>Origin Certificates]
            RP[Virtual hosts + Reverse Proxy]
        end

        subgraph StaticSites["Sites Estáticos (builds/)"]
            MONEXUP_UI["monexup.com<br/>MonexUp"]
            PANDORA["pandoravault.com<br/>PandoraVault"]
            BAZZUCA_UI["bazzuca.media<br/>Bazzuca Media"]
            PROXYPAY_UI["proxypay.online<br/>ProxyPay"]
            FORTUNO_UI["fortuno.online<br/>Fortuno"]
            JOGO_UI["jogodaeleicao.com<br/>Jogo da Eleição"]
            AMBROSIO_UI["ambrosioai.site<br/>Ambrosio"]
        end

        subgraph APIs["Backends (outros repositórios)"]
            MONEXUP_API["monexup-api<br/>:80"]
            PROXYPAY_API["proxypay-api<br/>:80"]
            FORTUNO_API["fortuno-api<br/>:80"]
            JOGO_API["jogoeleicao-api<br/>:80"]
            AMBROSIO_API["ambrosio-api<br/>:8080"]
            AMBROSIO_MCP["ambrosio-mcp<br/>:8080<br/>MCP + OAuth"]
        end

        subgraph Infra["docker-compose-infra.yml"]
            RMQ[/emagine-rabbitmq<br/>AMQP 5672 / UI 15672/]
            AUTOHEAL[autoheal]
        end

        SECRETS[(/root/emagine-secrets/SSL)]
    end

    subgraph K8s["Kubernetes — do-nyc2-emagine-k8s"]
        CFD[cloudflared]
        INGRESS[ingress-nginx<br/>ClusterIP]
        EMAGINE["emagine-web<br/>emagine.com.br<br/>(emagine-site)"]
        HEADLAMP["Headlamp<br/>rancher.emagine.com.br"]
    end

    subgraph CICD["GitHub Actions"]
        DEPLOY_PROD[deploy-prod.yml<br/>SSH + docker compose]
        DEPLOY_INFRA[deploy-infra.yml<br/>SSH, manual]
        DEPLOY_K8S[deploy-emagine-k8s.yml<br/>GHCR + kubectl, manual]
        GHCR[(GHCR<br/>emagine-web)]
    end

    %% Tráfego
    U --> EDGE
    EDGE -->|origin 443| SSL
    EDGE --> ACCESS
    ACCESS --> TUNNEL
    EDGE -->|emagine.com.br| TUNNEL
    TUNNEL --> CFD
    CFD --> INGRESS
    INGRESS --> EMAGINE
    INGRESS --> HEADLAMP

    SSL --> RP
    SECRETS -.->|volume read-only| SSL
    RP --> MONEXUP_UI
    RP --> PANDORA
    RP --> BAZZUCA_UI
    RP --> PROXYPAY_UI
    RP --> FORTUNO_UI
    RP --> JOGO_UI
    RP --> AMBROSIO_UI

    RP -->|monexup.com/api/| MONEXUP_API
    RP -->|proxypay.online/api/| PROXYPAY_API
    RP -->|fortuno.online/api/| FORTUNO_API
    RP -->|jogodaeleicao.com/api/| JOGO_API
    RP -->|ambrosioai.site/api/| AMBROSIO_API
    RP -->|ambrosioai.site/mcp, /auth/,<br/>/.well-known/oauth-*| AMBROSIO_MCP

    %% Deploy
    DEPLOY_PROD -.-> Nginx
    DEPLOY_INFRA -.-> Infra
    DEPLOY_K8S -.-> GHCR
    DEPLOY_K8S -.-> EMAGINE
    GHCR -.-> EMAGINE

    %% Styling
    classDef nginx fill:#2563eb,stroke:#1d4ed8,color:#fff
    classDef api fill:#7c3aed,stroke:#6d28d9,color:#fff
    classDef static fill:#059669,stroke:#047857,color:#fff
    classDef data fill:#d97706,stroke:#b45309,color:#fff
    classDef cloud fill:#f97316,stroke:#ea580c,color:#fff
    classDef k8s fill:#0891b2,stroke:#0e7490,color:#fff
    classDef ci fill:#6b7280,stroke:#4b5563,color:#fff

    class SSL,RP nginx
    class MONEXUP_API,PROXYPAY_API,FORTUNO_API,JOGO_API,AMBROSIO_API,AMBROSIO_MCP api
    class MONEXUP_UI,PANDORA,BAZZUCA_UI,PROXYPAY_UI,FORTUNO_UI,JOGO_UI,AMBROSIO_UI static
    class RMQ,AUTOHEAL,SECRETS data
    class EDGE,ACCESS,TUNNEL cloud
    class CFD,INGRESS,EMAGINE,HEADLAMP k8s
    class DEPLOY_PROD,DEPLOY_INFRA,DEPLOY_K8S,GHCR ci
